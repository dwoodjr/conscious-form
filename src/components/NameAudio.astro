---
// Audio + accumulation-effect logic for the homepage name
---

<script>
  let audioContext: AudioContext | null = null;

  function getAudioContext(): AudioContext {
    if (!audioContext) audioContext = new AudioContext();
    return audioContext;
  }

  // Resume AudioContext on first pointer press anywhere — no extra "activation click" needed
  document.addEventListener('pointerdown', () => getAudioContext().resume(), { once: true });

  const envelope = {
    attack: 0.005,
    decay: 0.3,
    sustain: 0.8,
    release: 0.5,
    peak: 0.12,
  };

  function playTone(frequency: number, gainScale: number = 1.0) {
    const ctx = getAudioContext();
    const now = ctx.currentTime;
    const oscillator = ctx.createOscillator();
    const gainNode = ctx.createGain();
    oscillator.connect(gainNode);
    gainNode.connect(ctx.destination);
    oscillator.type = 'triangle';
    oscillator.frequency.setValueAtTime(frequency, now);
    const { attack, decay, sustain, release, peak } = envelope;
    const scaledPeak = peak * Math.max(0.15, gainScale); // floor at 0.15 so nothing is silent
    const sustainLevel = scaledPeak * sustain;
    gainNode.gain.setValueAtTime(0, now);
    gainNode.gain.linearRampToValueAtTime(scaledPeak, now + attack);
    gainNode.gain.linearRampToValueAtTime(sustainLevel, now + attack + decay);
    const sustainTime = 0.1;
    gainNode.gain.setValueAtTime(sustainLevel, now + attack + decay + sustainTime);
    gainNode.gain.linearRampToValueAtTime(0, now + attack + decay + sustainTime + release);
    oscillator.start(now);
    oscillator.stop(now + attack + decay + sustainTime + release);
  }

  function triggerLetterAnimation(element: Element) {
    const letter = element.textContent;
    const color = element.getAttribute('data-color') || '#ffffff';
    element.classList.add('active');
    const ghost = document.createElement('div');
    ghost.className = 'ghost-letter';
    ghost.textContent = letter;
    ghost.style.color = color;
    const rect = element.getBoundingClientRect();
    ghost.style.left = `${rect.left + rect.width / 2}px`;
    ghost.style.top  = `${rect.top - 50}px`;
    document.body.appendChild(ghost);
    requestAnimationFrame(() => ghost.classList.add('show'));
    ghosts.add(ghost);
    setTimeout(() => element.classList.remove('active'), 200);
  }

  // ── Accumulation state ───────────────────────────────────────────────────────
  const visited = new Set<HTMLElement>();
  const ghosts  = new Set<HTMLElement>();
  const groupActive = new Set<string>(); // 'red' | 'yellow' | 'blue'
  let resetTimer: ReturnType<typeof setTimeout> | null = null;
  const RESET_DELAY = 5_000; // ms of inactivity before fade

  const hexToDot: Record<string, { name: string; glow: string }> = {
    '#E63946': { name: 'red',    glow: '#E63946' },
    '#F4D03F': { name: 'yellow', glow: '#F4D03F' },
    '#3B82F6': { name: 'blue',   glow: '#3B82F6' },
  };

  function getHeroDot(dotName: string): HTMLElement | null {
    return document.querySelector<HTMLElement>(`[data-accent-dot="${dotName}"]`);
  }

  function lockColor(el: HTMLElement) {
    const color = el.dataset.color ?? '';
    el.style.transition = 'none';
    el.style.color = color;
    visited.add(el);

    const info = hexToDot[color];
    if (info && !groupActive.has(info.name)) {
      groupActive.add(info.name);
      const dot = getHeroDot(info.name);
      if (dot) {
        dot.style.transition = 'opacity 0.4s ease-out, box-shadow 0.4s ease-out';
        dot.style.opacity = '1';
        dot.style.boxShadow = `0 0 12px 4px ${info.glow}`;
      }
    }
  }

  function scheduleReset() {
    if (resetTimer) clearTimeout(resetTimer);
    resetTimer = setTimeout(fadeAll, RESET_DELAY);
  }

  function fadeAll() {
    visited.forEach(el => {
      el.style.transition = 'color 2s ease-in-out';
      el.style.removeProperty('color');
      setTimeout(() => el.style.removeProperty('transition'), 2000);
    });
    visited.clear();

    groupActive.forEach(dotName => {
      const dot = getHeroDot(dotName);
      if (dot) {
        dot.style.transition = 'opacity 2s ease-in-out, box-shadow 2s ease-in-out';
        dot.style.opacity = '0.3';
        dot.style.boxShadow = 'none';
        setTimeout(() => dot.style.removeProperty('transition'), 2000);
      }
    });
    groupActive.clear();

    ghosts.forEach(ghost => {
      ghost.style.transition = 'opacity 1s ease-in-out';
      ghost.style.opacity = '0';
      setTimeout(() => ghost.remove(), 1000);
    });
    ghosts.clear();

    resetTimer = null;
  }

  // ── Init ─────────────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    // Start hero dots dimmed
    ['red', 'yellow', 'blue'].forEach(name => {
      const dot = getHeroDot(name);
      if (dot) dot.style.opacity = '0.3';
    });

    document.querySelectorAll<HTMLElement>('.sound-letter').forEach(letter => {
      letter.addEventListener('mouseenter', (e) => {
        const freq = parseFloat(letter.getAttribute('data-frequency') ?? '440');
        // Higher on screen (low clientY) = louder; lower (high clientY) = softer
        const yRatio   = (e as MouseEvent).clientY / window.innerHeight; // 0→top, 1→bottom
        const gainScale = 1.0 - yRatio * 0.8; // top=1.0, bottom=0.2
        playTone(freq, gainScale);
        triggerLetterAnimation(letter);
        lockColor(letter);
        scheduleReset();
      });
    });
  });
</script>

<style is:global>
  .sound-letter.active {
    transform: scale(1.1);
    color: var(--hover-color);
    transition: transform 0.1s ease-out, color 0.1s ease-out;
  }

  .ghost-letter {
    position: fixed;
    font-family: 'Inter', sans-serif;
    font-size: 3rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(0) translateX(-50%);
    pointer-events: none;
    z-index: 1000;
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
  }

  .ghost-letter.show {
    opacity: 0.6;
    transform: translateY(300px) translateX(-50%);
  }
</style>
