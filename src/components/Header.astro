---
import AccentDots from './AccentDots.astro';

const navLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/sketchbook', label: 'Sketchbook' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-800">
  <nav class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">

    {/* Logo */}
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
      <AccentDots />
      <span class="text-xl font-bold">Conscious Form</span>
    </a>

    {/* Desktop nav */}
    <ul class="hidden md:flex gap-6">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'hover:text-neutral-300 transition-colors',
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-white'
                : 'text-neutral-400'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    {/* Hamburger button — mobile only */}
    <button
      id="nav-toggle"
      class="md:hidden p-2 text-neutral-400 hover:text-white transition-colors"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <svg width="20" height="14" viewBox="0 0 20 14" fill="currentColor" aria-hidden="true">
        <rect y="0" width="20" height="2" rx="1"/>
        <rect y="6" width="20" height="2" rx="1"/>
        <rect y="12" width="20" height="2" rx="1"/>
      </svg>
    </button>

  </nav>

  {/* Mobile nav panel */}
  <div id="nav-panel" class="hidden md:hidden border-t border-neutral-800">
    <ul class="max-w-4xl mx-auto px-4 py-4 flex flex-col gap-5">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-lg hover:text-white transition-colors',
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-white'
                : 'text-neutral-400'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel  = document.getElementById('nav-panel');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
    panel.querySelectorAll('a').forEach(a =>
      a.addEventListener('click', () => panel.classList.add('hidden'))
    );
  }
</script>
