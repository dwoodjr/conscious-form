---
import AccentDots from './AccentDots.astro';

const navLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/sketchbook', label: 'Sketchbook' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-800">
  <nav class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
    
    {/* Logo with accent dots */}
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
      <AccentDots />
      <span class="text-xl font-bold">Conscious Form</span>
    </a>
    
    <ul class="flex gap-6">
      {navLinks.map(link => (
        <li>
          <a 
            href={link.href}
            class:list={[
              'hover:text-neutral-300 transition-colors',
              currentPath === link.href || currentPath.startsWith(link.href + '/') 
                ? 'text-white' 
                : 'text-neutral-400'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>