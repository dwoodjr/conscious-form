---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import SeriesNav from '../../components/SeriesNav.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

// Series siblings
let seriesProjects: typeof project[] = [];
if (project.data.series) {
  const allProjects = await getCollection('projects');
  seriesProjects = allProjects
    .filter(p => p.data.series === project.data.series)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}

// Derive the series overview page URL from the series title
// e.g. "Organic Memory (Triptych)" → "/projects/organic-memory"
const seriesHref = project.data.series
  ? `/projects/${project.data.series
      .replace(/\s*\(.*?\)/g, '')
      .trim()
      .toLowerCase()
      .replace(/\s+/g, '-')}`
  : null;

const hasSeries = seriesProjects.length > 1;
const hasVideos = project.data.videos && project.data.videos.length > 0;
const hasImages = project.data.images && project.data.images.length > 0;
---

<BaseLayout
  title={`${project.data.title} | Conscious Form`}
  description={project.data.description}
>
  <article class="max-w-4xl mx-auto px-4 py-16">

    {/* Header */}
    <header class="mb-8">
      <a href="/projects" class="text-neutral-400 hover:text-white transition-colors mb-4 inline-block">
        ← Back to Projects
      </a>
      <h1 class="text-4xl font-bold mb-4">{project.data.title}</h1>
      <p class="text-xl text-neutral-400 mb-4">{project.data.description}</p>

      <div class="flex flex-wrap gap-2 mb-4">
        {project.data.tags.map(tag => (
          <span class="text-sm bg-neutral-800 px-2 py-1 rounded">{tag}</span>
        ))}
      </div>

      <time class="text-sm text-neutral-500">
        {new Date(project.data.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
        })}
      </time>
    </header>

    {/* Series navigation banner */}
    {hasSeries && (
      <SeriesNav current={project} siblings={seriesProjects} seriesHref={seriesHref!} />
    )}

    {/* Thumbnail - ALWAYS show if it exists */}
    {project.data.thumbnail && (
      <div class="mb-8">
        <img
          src={project.data.thumbnail}
          alt={project.data.title}
          class="w-full rounded-lg object-cover"
        />
      </div>
    )}

    {/* Markdown content */}
    <div class="prose prose-invert max-w-none mb-12">
      <Content />
    </div>

  {/* Videos + Gallery - constrained to same width */}
  {(hasVideos || hasImages) && (
    <div class="mb-8 flex flex-col">

      {/* Videos */}
      {hasVideos && (
        <div class="w-full mb-4">
          <h2 class="text-2xl font-semibold mb-6">
            {project.data.videos!.length === 1 ? 'Video' : 'Videos'}
          </h2>
          {project.data.videos!.map((video, i) => (
            <div class="mb-4">
              {video.title && (
                <p class="text-neutral-400 text-sm mb-2">{video.title}</p>
              )}
              <VideoEmbed video={video} index={i} />
            </div>
          ))}
        </div>
      )}

      {/* Image Gallery - same width as video */}
      {hasImages && (
        <div class="w-full">
          <h2 class="text-2xl font-semibold mb-6">Documentation</h2>
          <ImageGallery images={project.data.images!} title={project.data.title} />
          {project.data.imageCredit && (
            <p class="text-xs text-neutral-500 mt-3">
              Images courtesy of{' '}
              {project.data.imageCredit.url ? (
                <a
                  href={project.data.imageCredit.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-neutral-300 transition-colors underline underline-offset-2"
                >
                  {project.data.imageCredit.name}
                </a>
              ) : (
                project.data.imageCredit.name
              )}
            </p>
          )}
        </div>
      )}

    </div>
  )}

  </article>
</BaseLayout>
