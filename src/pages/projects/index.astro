---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const collaborations = await getCollection('collaborations');

function byOrderThenDate<T extends { data: { order?: number; date: Date } }>(a: T, b: T) {
  const aHas = a.data.order !== undefined;
  const bHas = b.data.order !== undefined;
  if (aHas && bHas) {
    const diff = a.data.order! - b.data.order!;
    if (diff !== 0) return diff;
  } else if (aHas) return -1;
  else if (bHas) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
}

const dissertationProjects = allProjects
  .filter(p => p.data.dissertation)
  .sort(byOrderThenDate);

const otherProjects = allProjects
  .filter(p => !p.data.dissertation)
  .sort(byOrderThenDate);

const sortedCollabs = collaborations.sort(byOrderThenDate);
---

<BaseLayout title="Projects | Conscious Form">
  <section class="max-w-4xl mx-auto px-4 py-16">
    
    {/* Collaborations */}
    <div class="mb-16">
      <h2 class="text-3xl font-bold mb-2">Collaborations</h2>
      <p class="text-neutral-400 mb-8">
        Interdisciplinary work with artists, dancers, and technologists.
      </p>
      
      <div class="grid gap-8">
        {sortedCollabs.map(collab => (
          <a 
            href={`/collaborations/${collab.slug}`}
            class="group block border border-neutral-800 rounded-lg overflow-hidden hover:border-neutral-600 transition-colors"
          >
            <div class="aspect-video bg-neutral-900 overflow-hidden flex items-center justify-center">
              {collab.data.thumbnail ? (
                <img 
                  src={collab.data.thumbnail} 
                  alt={collab.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <span class="text-neutral-600 text-sm">Image coming soon</span>
              )}
            </div>
            
            <div class="p-6">
              <h2 class="text-2xl font-semibold mb-2 group-hover:text-neutral-300 transition-colors">
                {collab.data.title}
              </h2>
              <p class="text-neutral-400 mb-2">{collab.data.description}</p>
              <p class="text-sm text-neutral-500 mb-4">
                {collab.data.partner} · {collab.data.role}
              </p>
              <div class="flex flex-wrap gap-2">
                {collab.data.tags.map(tag => (
                  <span class="text-sm bg-neutral-800 px-2 py-1 rounded">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* Research-Creation */}
    {otherProjects.length > 0 && (
      <div class="mb-16">
        <h1 class="text-4xl font-bold mb-2">Research-Creation</h1>
        <p class="text-neutral-400 mb-8">
          Independent research exploring sound, physical computing, and speculative design.
        </p>

        <div class="grid gap-8">
          {otherProjects.map(project => (
            <a
              href={`/projects/${project.slug}`}
              class="group block border border-neutral-800 rounded-lg overflow-hidden hover:border-neutral-600 transition-colors"
            >
              <div class="aspect-video bg-neutral-900 overflow-hidden flex items-center justify-center">
                {project.data.thumbnail ? (
                  <img
                    src={project.data.thumbnail}
                    alt={project.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <span class="text-neutral-600 text-sm">Image coming soon</span>
                )}
              </div>

              <div class="p-6">
                <h2 class="text-2xl font-semibold mb-2 group-hover:text-neutral-300 transition-colors">
                  {project.data.title}
                </h2>
                <p class="text-neutral-400 mb-4">{project.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <span class="text-sm bg-neutral-800 px-2 py-1 rounded">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Dissertation Research */}
    {dissertationProjects.length > 0 && (
      <div class="mb-16">
        <h1 class="text-4xl font-bold mb-2">Dissertation Research</h1>
        <p class="text-neutral-400 mb-8">
          Active research-creation projects exploring sound, identity, and speculative design.
        </p>

        <div class="grid gap-8">
          {dissertationProjects.map(project => (
            <a
              href={`/projects/${project.slug}`}
              class="group block border border-neutral-800 rounded-lg overflow-hidden hover:border-neutral-600 transition-colors"
            >
              <div class="aspect-video bg-neutral-900 overflow-hidden flex items-center justify-center">
                {project.data.thumbnail ? (
                  <img
                    src={project.data.thumbnail}
                    alt={project.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <span class="text-neutral-600 text-sm">Image coming soon</span>
                )}
              </div>

              <div class="p-6">
                <h2 class="text-2xl font-semibold mb-2 group-hover:text-neutral-300 transition-colors">
                  {project.data.title}
                </h2>
                <p class="text-neutral-400 mb-4">{project.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <span class="text-sm bg-neutral-800 px-2 py-1 rounded">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </section>
</BaseLayout>
