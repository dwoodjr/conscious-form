---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog | Conscious Form">
  <section class="max-w-4xl mx-auto px-4 py-32 text-center">

    <div class="mb-8">
      <h1 class="text-5xl font-bold mb-4">Blog</h1>
      <p class="text-xl text-neutral-400">
        Writing on sound, speculative design, research-creation, and process.
      </p>
    </div>

    <div class="border border-neutral-800 rounded-lg p-12 text-neutral-500">
      <p class="text-2xl mb-2">Coming soon.</p>
      <p class="text-sm">Check back later.</p>
    </div>

  </section>
</BaseLayout>
