  }

  #graph-container {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  #graph-svg {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  #graph-svg:active { cursor: grabbing; }

