---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const experimentItems = await getCollection('experiments');
const sortedItems = [...experimentItems].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect referenced project/collab slugs across all experiment entries
const referencedSlugs = new Set<string>();
experimentItems.forEach(item => {
  (item.data.relatedProjects ?? []).forEach(s => referencedSlugs.add(s));
});

// Fetch and filter referenced works
const allProjects = await getCollection('projects');
const allCollaborations = await getCollection('collaborations');
const referencedWorks = [
  ...allProjects
    .filter(p => referencedSlugs.has(p.slug))
    .map(p => ({ slug: p.slug, data: p.data, href: `/projects/${p.slug}`, collectionType: 'project' as const })),
  ...allCollaborations
    .filter(c => referencedSlugs.has(c.slug))
    .map(c => ({ slug: c.slug, data: c.data, href: `/collaborations/${c.slug}`, collectionType: 'collaboration' as const })),
];

type Category = 'sound' | 'visual' | 'code' | 'other';

const CATEGORIES: { id: Category; label: string; color: string }[] = [
  { id: 'sound', label: 'Sound', color: '#E63946' },
  { id: 'visual', label: 'Visual', color: '#F4D03F' },
  { id: 'code', label: 'Code / Interactive', color: '#3B82F6' },
  { id: 'other', label: 'Other', color: '#e5e5e5' },
];

function getCategory(item: CollectionEntry<'experiments'>): Category {
  const tags = item.data.tags ?? [];
  if (tags.some(t => ['sound', 'audio', 'synthesis', 'max'].includes(t))) return 'sound';
  if (tags.some(t => ['animation', '3d', 'visual', 'houdini', 'video', 'unreal'].includes(t))) return 'visual';
  if (tags.some(t => ['code', 'patch', 'interactive', 'web', 'physical-computing'].includes(t))) return 'code';
  return 'other';
}

function getNodeColor(item: CollectionEntry<'experiments'>): string {
  return CATEGORIES.find(c => c.id === getCategory(item))!.color;
}

function getNodeRadius(index: number): number {
  if (index === 0) return 28;
  if (index < 3) return 22;
  if (index < 8) return 17;
  return 12;
}

interface NodeData {
  id: string;
  title: string;
  color: string;
  radius: number;
  thumbnail: string | null;
  tags: string[];
  description: string;
  href: string;
  audioPreview: string | null;
  videoPreview: string | null;
  nodeType: 'experiment' | 'project';
}

interface LinkData {
  source: string;
  target: string;
  explicit: boolean;
}

const experimentNodes: NodeData[] = sortedItems.map((item, index) => ({
  id: item.slug,
  title: item.data.title,
  color: getNodeColor(item),
  radius: getNodeRadius(index),
  thumbnail: item.data.thumbnail ?? null,
  tags: item.data.tags ?? [],
  description: item.data.description,
  href: `/experiments/${item.slug}`,
  audioPreview: item.data.audioPreview ?? null,
  videoPreview: item.data.videoPreview ?? null,
  nodeType: 'experiment',
}));

const projectNodes: NodeData[] = referencedWorks.map(p => ({
  id: `proj:${p.slug}`,
  title: p.data.title,
  color: '#a855f7',
  radius: 26,
  thumbnail: p.data.thumbnail ?? null,
  tags: p.data.tags ?? [],
  description: p.data.description,
  href: p.href,
  audioPreview: null,
  videoPreview: null,
  nodeType: 'project',
}));

const graphNodes: NodeData[] = [...experimentNodes, ...projectNodes];
const slugSet = new Set(sortedItems.map(i => i.slug));

const seenKeys = new Set<string>();
const explicitEdges: LinkData[] = [];

// Intra-experiments explicit edges from relatedTo
sortedItems.forEach(item => {
  (item.data.relatedTo ?? []).forEach(slug => {
    if (!slugSet.has(slug)) return;
    const key = [item.slug, slug].sort().join('|');
    if (!seenKeys.has(key)) {
      seenKeys.add(key);
      explicitEdges.push({ source: item.slug, target: slug, explicit: true });
    }
  });
});

// Cross-collection edges from relatedProjects
sortedItems.forEach(item => {
  (item.data.relatedProjects ?? []).forEach(projSlug => {
    const nodeId = `proj:${projSlug}`;
    if (!graphNodes.find(n => n.id === nodeId)) return;
    const key = [item.slug, nodeId].sort().join('|');
    if (!seenKeys.has(key)) {
      seenKeys.add(key);
      explicitEdges.push({ source: item.slug, target: nodeId, explicit: true });
    }
  });
});

// Loose web texture — experiment nodes only
const looseEdges: LinkData[] = [];
for (let i = 0; i < experimentNodes.length; i++) {
  for (let j = i + 1; j < experimentNodes.length; j++) {
    const key = [experimentNodes[i].id, experimentNodes[j].id].sort().join('|');
    if (!seenKeys.has(key)) {
      looseEdges.push({ source: experimentNodes[i].id, target: experimentNodes[j].id, explicit: false });
    }
  }
}

const graphData = { nodes: graphNodes, links: [...explicitEdges, ...looseEdges] };
const hasItems = sortedItems.length > 0;

// ── List view data ───────────────────────────────────────────────────────
const workTitles = new Map<string, { title: string; href: string }>(
  referencedWorks.map(w => [w.slug, { title: w.data.title, href: w.href }]),
);

const typeLabels: Record<string, string> = {
  experiment: 'Experiment',
  coursework: 'Coursework',
  sketch: 'Sketch',
  demo: 'Demo',
  animation: 'Animation',
};

const listItems = sortedItems.map(item => {
  const category = getCategory(item);
  const related = (item.data.relatedProjects ?? [])
    .map(slug => workTitles.get(slug))
    .find(Boolean);
  return {
    slug: item.slug,
    href: `/experiments/${item.slug}`,
    title: item.data.title,
    description: item.data.description,
    thumbnail: item.data.thumbnail ?? null,
    category,
    color: getNodeColor(item),
    typeLabel: typeLabels[item.data.type] ?? item.data.type,
    date: new Date(item.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' }),
    related: related ?? null,
  };
});

const presentCategories = CATEGORIES.filter(c => listItems.some(i => i.category === c.id));
---

<BaseLayout title="Experiments | Conscious Form">

  <div id="experiments-root" class="sketchbook-wrapper" data-view="list">

    <div class="sketchbook-header">
      <div class="header-row">
        <div>
          <h1 class="text-4xl font-bold mb-1">Experiments</h1>
          <p class="text-neutral-400 text-sm">
            Experiments, explorations, ephemera.<span class="graph-hint"> Click a node to open it.</span>
          </p>
        </div>
        {hasItems && (
          <div class="view-toggle" role="group" aria-label="Choose a view">
            <button type="button" class="view-btn" data-view-btn="list" aria-pressed="true">List</button>
            <button type="button" class="view-btn" data-view-btn="graph" aria-pressed="false">Graph</button>
          </div>
        )}
      </div>
    </div>

    <!-- List view (default) -->
    <section id="list-view" aria-label="Experiments list">
      {hasItems ? (
        <>
          {presentCategories.length > 1 && (
            <div class="filter-row" role="group" aria-label="Filter by category">
              <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">All</button>
              {presentCategories.map(c => (
                <button type="button" class="filter-chip" data-filter={c.id} aria-pressed="false">
                  <span class="legend-dot" style={`background:${c.color}`}></span>{c.label}
                </button>
              ))}
            </div>
          )}
          <ul class="card-grid">
            {listItems.map(item => (
              <li data-category={item.category}>
                <a href={item.href} class="card">
                  {item.thumbnail ? (
                    <img src={item.thumbnail} alt="" loading="lazy" class="card-thumb" />
                  ) : (
                    <div class="card-thumb card-thumb--empty" style={`--accent:${item.color}`}></div>
                  )}
                  <div class="card-body">
                    <p class="card-meta">
                      <span class="legend-dot" style={`background:${item.color}`}></span>
                      {item.typeLabel} · {item.date}
                    </p>
                    <h2 class="card-title">{item.title}</h2>
                    <p class="card-desc">{item.description}</p>
                    {item.related && (
                      <p class="card-related">Related project: <em>{item.related.title}</em></p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="empty-list">Nothing here yet.</p>
      )}
    </section>

    <!-- Graph view (optional) -->
    <section id="graph-view" aria-label="Experiments graph" hidden>

    <div id="graph-container">
      {hasItems ? (
        <svg id="graph-svg" aria-label="Experiments graph">
          <defs id="svg-defs"></defs>
          <g id="zoom-layer">
            <g id="links-layer"></g>
            <g id="nodes-layer"></g>
          </g>
        </svg>
      ) : (
        <p class="empty-state">Nothing here yet.</p>
      )}
    </div>

    <!-- Preview panel (hidden until a node is clicked) -->
    <div id="preview-panel" class="preview-panel" aria-hidden="true">
      <button id="preview-close" class="preview-close" aria-label="Close">×</button>
      <div id="preview-thumb-wrap" class="preview-thumb-wrap">
        <img id="preview-thumb" class="preview-thumb" src="" alt="" />
      </div>
      <div class="preview-body">
        <div id="preview-type-badge" class="preview-type-badge"></div>
        <h3 id="preview-title" class="preview-title"></h3>
        <div id="preview-tags" class="preview-tags"></div>
        <p id="preview-desc" class="preview-desc"></p>
        <a id="preview-visit" class="preview-visit" href="#">Open →</a>
      </div>
    </div>

    <div class="graph-legend" aria-hidden="true">
      <span class="legend-item"><span class="legend-dot" style="background:#E63946"></span>Sound</span>
      <span class="legend-item"><span class="legend-dot" style="background:#F4D03F"></span>Visual</span>
      <span class="legend-item"><span class="legend-dot" style="background:#3B82F6"></span>Code / Interactive</span>
      <span class="legend-item"><span class="legend-dot legend-dot--dashed" style="border-color:#a855f7"></span>Project</span>
    </div>

    </section>

  </div>

</BaseLayout>

<script define:vars={{ graphData, hasItems }} is:inline>
  window.__experimentsGraph = graphData;
  window.__experimentsHasItems = hasItems;
</script>

<style>
  .sketchbook-wrapper {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 4rem);
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
    position: relative;
  }

  .sketchbook-header {
    flex-shrink: 0;
    margin-bottom: 0.75rem;
  }

  /* ── View modes ──────────────────────────────── */
  .sketchbook-wrapper[data-view="list"] {
    display: block;
    height: auto;
    overflow: visible;
    max-width: 64rem;
    margin: 0 auto;
    padding: 4rem 1rem;
  }
  .sketchbook-wrapper[data-view="list"] .sketchbook-header { margin-bottom: 1.5rem; }
  .sketchbook-wrapper[data-view="list"] .graph-hint { display: none; }

  #graph-view:not([hidden]) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .view-toggle {
    display: inline-flex;
    border: 1px solid #2e2e2e;
    border-radius: 999px;
    padding: 3px;
    background: #0f0f0f;
  }
  .view-btn {
    font-size: 0.8rem;
    color: #8a8a8a;
    background: none;
    border: none;
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .view-btn:hover { color: #e5e5e5; }
  .view-btn[aria-pressed="true"] { background: #262626; color: #fafafa; }
  .view-btn:focus-visible, .filter-chip:focus-visible, .card:focus-visible {
    outline: 2px solid #3B82F6;
    outline-offset: 2px;
  }

  /* ── List view ───────────────────────────────── */
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #a3a3a3;
    background: #141414;
    border: 1px solid #262626;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .filter-chip:hover { color: #e5e5e5; border-color: #404040; }
  .filter-chip[aria-pressed="true"] { color: #fafafa; border-color: #737373; }

  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid #262626;
    border-radius: 10px;
    overflow: hidden;
