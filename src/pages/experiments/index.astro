    display: block;
    background: #141414;
  }
  .card-thumb--empty {
    background:
      radial-gradient(circle at 50% 50%, var(--accent) 0 5px, transparent 6px),
      #141414;
    opacity: 0.8;
  }

  .card-body { padding: 0.9rem 1rem 1.1rem; }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #737373;
    margin-bottom: 0.4rem;
  }
  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #f5f5f5;
    line-height: 1.3;
    margin-bottom: 0.4rem;
  }
  .card-desc {
    font-size: 0.85rem;
    color: #8a8a8a;
    line-height: 1.55;
  }
  .card-related {
    font-size: 0.75rem;
    color: #a855f7;
    margin-top: 0.6rem;
  }

