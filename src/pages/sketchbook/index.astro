---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const sketchbookItems = await getCollection('sketchbook');
const sortedItems = [...sketchbookItems].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect referenced project/collab slugs across all sketchbook entries
const referencedSlugs = new Set<string>();
sketchbookItems.forEach(item => {
  (item.data.relatedProjects ?? []).forEach(s => referencedSlugs.add(s));
});

// Fetch and filter referenced works
const allProjects = await getCollection('projects');
const allCollaborations = await getCollection('collaborations');
const referencedWorks = [
  ...allProjects
    .filter(p => referencedSlugs.has(p.slug))
    .map(p => ({ slug: p.slug, data: p.data, href: `/projects/${p.slug}`, collectionType: 'project' as const })),
  ...allCollaborations
    .filter(c => referencedSlugs.has(c.slug))
    .map(c => ({ slug: c.slug, data: c.data, href: `/collaborations/${c.slug}`, collectionType: 'collaboration' as const })),
];

function getNodeColor(item: CollectionEntry<'sketchbook'>): string {
  const tags = item.data.tags ?? [];
  if (tags.some(t => ['sound', 'audio', 'synthesis', 'max'].includes(t))) return '#E63946';
  if (tags.some(t => ['animation', '3d', 'visual', 'houdini', 'video', 'unreal'].includes(t))) return '#F4D03F';
  if (tags.some(t => ['code', 'patch', 'interactive', 'web', 'physical-computing'].includes(t))) return '#3B82F6';
  return '#e5e5e5';
}

function getNodeRadius(index: number): number {
  if (index === 0) return 28;
  if (index < 3) return 22;
  if (index < 8) return 17;
  return 12;
}

interface NodeData {
  id: string;
  title: string;
  color: string;
  radius: number;
  thumbnail: string | null;
  tags: string[];
  description: string;
  href: string;
  audioPreview: string | null;
  videoPreview: string | null;
  nodeType: 'sketchbook' | 'project';
}

interface LinkData {
  source: string;
  target: string;
  explicit: boolean;
}

const sketchbookNodes: NodeData[] = sortedItems.map((item, index) => ({
  id: item.slug,
  title: item.data.title,
  color: getNodeColor(item),
  radius: getNodeRadius(index),
  thumbnail: item.data.thumbnail ?? null,
  tags: item.data.tags ?? [],
  description: item.data.description,
  href: `/sketchbook/${item.slug}`,
  audioPreview: item.data.audioPreview ?? null,
  videoPreview: item.data.videoPreview ?? null,
  nodeType: 'sketchbook',
}));

const projectNodes: NodeData[] = referencedWorks.map(p => ({
  id: `proj:${p.slug}`,
  title: p.data.title,
  color: '#a855f7',
  radius: 26,
  thumbnail: p.data.thumbnail ?? null,
  tags: p.data.tags ?? [],
  description: p.data.description,
  href: p.href,
  audioPreview: null,
  videoPreview: null,
  nodeType: 'project',
}));

const graphNodes: NodeData[] = [...sketchbookNodes, ...projectNodes];
const slugSet = new Set(sortedItems.map(i => i.slug));

const seenKeys = new Set<string>();
const explicitEdges: LinkData[] = [];

// Intra-sketchbook explicit edges from relatedTo
sortedItems.forEach(item => {
  (item.data.relatedTo ?? []).forEach(slug => {
    if (!slugSet.has(slug)) return;
    const key = [item.slug, slug].sort().join('|');
    if (!seenKeys.has(key)) {
      seenKeys.add(key);
      explicitEdges.push({ source: item.slug, target: slug, explicit: true });
    }
  });
});

// Cross-collection edges from relatedProjects
sortedItems.forEach(item => {
  (item.data.relatedProjects ?? []).forEach(projSlug => {
    const nodeId = `proj:${projSlug}`;
    if (!graphNodes.find(n => n.id === nodeId)) return;
    const key = [item.slug, nodeId].sort().join('|');
    if (!seenKeys.has(key)) {
      seenKeys.add(key);
      explicitEdges.push({ source: item.slug, target: nodeId, explicit: true });
    }
  });
});

// Loose web texture — sketchbook nodes only
const looseEdges: LinkData[] = [];
for (let i = 0; i < sketchbookNodes.length; i++) {
  for (let j = i + 1; j < sketchbookNodes.length; j++) {
    const key = [sketchbookNodes[i].id, sketchbookNodes[j].id].sort().join('|');
    if (!seenKeys.has(key)) {
      looseEdges.push({ source: sketchbookNodes[i].id, target: sketchbookNodes[j].id, explicit: false });
    }
  }
}

const graphData = { nodes: graphNodes, links: [...explicitEdges, ...looseEdges] };
const hasItems = sortedItems.length > 0;
---

<BaseLayout title="Sketchbook | Conscious Form">

  <div class="sketchbook-wrapper">

    <div class="sketchbook-header">
      <h1 class="text-4xl font-bold mb-1">Sketchbook</h1>
      <p class="text-neutral-400 text-sm">
        Experiments, explorations, ephemera. Click a node to explore.
      </p>
    </div>

    <div id="graph-container">
      {hasItems ? (
        <svg id="graph-svg" aria-label="Sketchbook graph">
          <defs id="svg-defs"></defs>
          <g id="zoom-layer">
            <g id="links-layer"></g>
            <g id="nodes-layer"></g>
          </g>
        </svg>
      ) : (
        <p class="empty-state">Nothing here yet.</p>
      )}
    </div>

    <!-- Preview panel (hidden until a node is clicked) -->
    <div id="preview-panel" class="preview-panel" aria-hidden="true">
      <button id="preview-close" class="preview-close" aria-label="Close">×</button>
      <div id="preview-thumb-wrap" class="preview-thumb-wrap">
        <img id="preview-thumb" class="preview-thumb" src="" alt="" />
      </div>
      <div class="preview-body">
        <div id="preview-type-badge" class="preview-type-badge"></div>
        <h3 id="preview-title" class="preview-title"></h3>
        <div id="preview-tags" class="preview-tags"></div>
        <p id="preview-desc" class="preview-desc"></p>
        <a id="preview-visit" class="preview-visit" href="#">Open →</a>
      </div>
    </div>

    <div class="graph-legend" aria-hidden="true">
      <span class="legend-item"><span class="legend-dot" style="background:#E63946"></span>Sound</span>
      <span class="legend-item"><span class="legend-dot" style="background:#F4D03F"></span>Visual</span>
      <span class="legend-item"><span class="legend-dot" style="background:#3B82F6"></span>Code / Interactive</span>
      <span class="legend-item"><span class="legend-dot legend-dot--dashed" style="border-color:#a855f7"></span>Project</span>
    </div>

  </div>

</BaseLayout>

<script define:vars={{ graphData, hasItems }} is:inline>
  window.__sketchbookGraph = graphData;
  window.__sketchbookHasItems = hasItems;
</script>

<style>
  .sketchbook-wrapper {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 4rem);
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
    position: relative;
  }

  .sketchbook-header {
    flex-shrink: 0;
    margin-bottom: 0.75rem;
  }

  #graph-container {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  #graph-svg {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  #graph-svg:active { cursor: grabbing; }

  .empty-state {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #525252;
    font-style: italic;
  }

  /* ── Preview panel ───────────────────────────── */
  .preview-panel {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.94);
    width: 268px;
    background: #0a0a0a;
    border: 1px solid #2e2e2e;
    border-radius: 10px;
    padding: 1.125rem;
    z-index: 200;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.85);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .preview-panel.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
  }

  .preview-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: none;
    border: none;
    color: #525252;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s;
  }
  .preview-close:hover { color: #e5e5e5; }

  .preview-thumb-wrap {
    width: 100%;
    height: 118px;
    background: #141414;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 0.875rem;
  }
  .preview-thumb-wrap.hidden { display: none; }
  .preview-thumb { width: 100%; height: 100%; object-fit: cover; display: block; }

  .preview-type-badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    margin-bottom: 0.35rem;
    background: #1a0a2e;
    color: #a855f7;
    border: 1px solid #3d1e6e;
  }
  .preview-type-badge:empty { display: none; }

  .preview-title {
    font-size: 0.96rem;
    font-weight: 600;
    color: #f5f5f5;
    margin-bottom: 0.4rem;
    line-height: 1.35;
  }

  .preview-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
  }
  .preview-tag {
    font-size: 0.68rem;
    background: #1c1c1c;
    color: #737373;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .preview-desc {
    font-size: 0.78rem;
    color: #636363;
    line-height: 1.55;
    margin-bottom: 0.875rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .preview-visit {
    display: inline-block;
    font-size: 0.82rem;
    color: #e5e5e5;
    background: #1c1c1c;
    border: 1px solid #333;
    border-radius: 5px;
    padding: 0.375rem 0.875rem;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .preview-visit:hover { background: #272727; border-color: #555; }
  .preview-visit.project-link {
    border-color: #3d1e6e;
    color: #c084fc;
  }
  .preview-visit.project-link:hover { background: #1a0a2e; border-color: #6b21a8; }

  /* ── Legend ──────────────────────────────────── */
  .graph-legend {
    flex-shrink: 0;
    display: flex;
    gap: 1.25rem;
    padding: 0.625rem 0;
    font-size: 0.72rem;
    color: #525252;
  }
  .legend-item { display: flex; align-items: center; gap: 0.35rem; }
  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.85;
  }
  .legend-dot--dashed {
    background: transparent;
    border: 1.5px dashed;
    opacity: 1;
  }
</style>

<script>
  import {
    forceSimulation,
    forceLink,
    forceManyBody,
    forceCenter,
    forceCollide,
    select,
    drag,
    zoom,
    type SimulationNodeDatum,
    type SimulationLinkDatum,
  } from 'd3';

  // ── Types ──────────────────────────────────────────────────────────────
  interface NodeDatum extends SimulationNodeDatum {
    id: string;
    title: string;
    color: string;
    radius: number;
    thumbnail: string | null;
    tags: string[];
    description: string;
    href: string;
    audioPreview: string | null;
    videoPreview: string | null;
    nodeType: 'sketchbook' | 'project';
  }

  interface LinkDatum extends SimulationLinkDatum<NodeDatum> {
    explicit: boolean;
  }

  function asNode(end: string | number | NodeDatum): NodeDatum {
    return end as NodeDatum;
  }

  // ── Guard ──────────────────────────────────────────────────────────────
  const w = window as typeof window & {
    __sketchbookGraph: { nodes: NodeDatum[]; links: LinkDatum[] };
    __sketchbookHasItems: boolean;
  };
  if (!w.__sketchbookHasItems) {
    // no items — static empty state is already rendered
  } else {
    const { nodes, links } = w.__sketchbookGraph;

    // ── DOM ───────────────────────────────────────────────────────────────
    const container = document.getElementById('graph-container')!;
    const svgEl = document.getElementById('graph-svg') as unknown as SVGSVGElement;
    const svg = select(svgEl);
    const defs = svg.select<SVGDefsElement>('#svg-defs');
    const zoomLayer = svg.select<SVGGElement>('#zoom-layer');
    const linksLayer = zoomLayer.select<SVGGElement>('#links-layer');
    const nodesLayer = zoomLayer.select<SVGGElement>('#nodes-layer');

    let W = container.clientWidth;
    let H = container.clientHeight;

    // ── Zoom / pan ────────────────────────────────────────────────────────
    const zoomBehavior = zoom<SVGSVGElement, unknown>()
      .scaleExtent([0.2, 6])
      .on('zoom', ({ transform }) => zoomLayer.attr('transform', String(transform)));

    svg.call(zoomBehavior);
    svg.on('click.panel', () => hidePanel());

    // ── Simulation ────────────────────────────────────────────────────────
    const sim = forceSimulation<NodeDatum>(nodes)
      .force(
        'link',
        forceLink<NodeDatum, LinkDatum>(links as LinkDatum[])
          .id(d => d.id)
          .distance(d => d.explicit ? 115 : 175)
          .strength(d => d.explicit ? 0.65 : 0.04),
      )
      .force('charge', forceManyBody<NodeDatum>().strength(-270))
      .force('center', forceCenter<NodeDatum>(W / 2, H / 2).strength(0.05))
      .force('collide', forceCollide<NodeDatum>().radius(d => d.radius + 10).strength(0.85))
      .alphaDecay(0.007)
      .alphaTarget(0.06)
      .velocityDecay(0.72);

    // ── Edges ─────────────────────────────────────────────────────────────
    const linkEls = linksLayer
      .selectAll<SVGLineElement, LinkDatum>('line')
      .data(links as LinkDatum[])
      .join('line')
      .attr('stroke', d => d.explicit ? 'rgba(168,85,247,0.35)' : 'rgba(255,255,255,0.05)')
      .attr('stroke-width', d => d.explicit ? 1.5 : 0.5)
      .attr('stroke-dasharray', d => {
        const s = asNode(d.source);
        const t = asNode(d.target);
        if (s.nodeType === 'project' || t.nodeType === 'project') return '4,3';
        return d.explicit ? null : null;
      });

    // ── Nodes ─────────────────────────────────────────────────────────────
    const nodeEls = nodesLayer
      .selectAll<SVGGElement, NodeDatum>('g.node')
      .data(nodes)
      .join('g')
      .attr('class', 'node')
      .style('cursor', 'pointer');

    // Circle — project nodes get dashed stroke and no fill
    nodeEls.append('circle')
      .attr('r', d => d.radius)
      .attr('fill', d => {
        if (d.nodeType === 'project') return 'none';
        return d.thumbnail ? d.color + '0c' : d.color + '18';
      })
      .attr('stroke', d => d.color)
      .attr('stroke-width', d => d.nodeType === 'project' ? 2 : 2)
      .attr('stroke-dasharray', d => d.nodeType === 'project' ? '5,3' : null);

    // Thumbnail via SVG clipPath + image (both sketchbook and project nodes)
    nodeEls.each(function(d) {
      if (!d.thumbnail) return;
      const g = select(this);
      const clipId = `clip-${d.id.replace(/[^a-z0-9]/gi, '-')}`;
      defs.append('clipPath').attr('id', clipId)
        .append('circle').attr('r', d.radius - 1);
      g.append('image')
        .attr('href', d.thumbnail)
        .attr('x', -(d.radius - 1)).attr('y', -(d.radius - 1))
        .attr('width', (d.radius - 1) * 2).attr('height', (d.radius - 1) * 2)
        .attr('clip-path', `url(#${clipId})`)
        .attr('preserveAspectRatio', 'xMidYMid slice')
        .attr('opacity', d.nodeType === 'project' ? 0.45 : 0.88);
    });

    // Label
    nodeEls.append('text')
      .attr('class', 'node-label')
      .attr('dy', d => d.radius + 13)
      .attr('text-anchor', 'middle')
      .attr('fill', d => d.nodeType === 'project' ? '#7c3aed' : '#4a4a4a')
      .attr('font-size', '11')
      .attr('font-family', 'Inter, sans-serif')
      .attr('pointer-events', 'none')
      .text(d => d.title);

    // ── Hover ─────────────────────────────────────────────────────────────
    let currentAudio: HTMLAudioElement | null = null;

    nodeEls
      .on('mouseenter', function(_, d) {
        const connected = new Set<string>([d.id]);
        (links as LinkDatum[]).forEach(l => {
          const s = asNode(l.source).id;
          const t = asNode(l.target).id;
          if (s === d.id) connected.add(t);
          if (t === d.id) connected.add(s);
        });

        nodeEls.style('opacity', n => connected.has(n.id) ? '1' : '0.12');
        nodeEls.select<SVGTextElement>('text')
          .attr('fill', n => {
            if (n.id === d.id) return '#c8c8c8';
            return n.nodeType === 'project' ? '#7c3aed' : '#4a4a4a';
          });

        linkEls.attr('stroke', l => {
          const s = asNode(l.source).id;
          const t = asNode(l.target).id;
          const hit = s === d.id || t === d.id;
          if (!hit) return 'rgba(255,255,255,0.02)';
          const crossProject = asNode(l.source).nodeType === 'project' || asNode(l.target).nodeType === 'project';
          if (crossProject) return hit ? 'rgba(168,85,247,0.9)' : 'rgba(168,85,247,0.08)';
          return l.explicit ? 'rgba(255,255,255,0.9)' : 'rgba(255,255,255,0.22)';
        });

        select(this).select<SVGCircleElement>('circle')
          .attr('r', d.radius * 1.18)
          .attr('stroke-width', 2.5);

        if (d.audioPreview) {
          currentAudio = new Audio(d.audioPreview);
          currentAudio.volume = 0.4;
          currentAudio.play().catch(() => {});
        }
      })
      .on('mouseleave', function(_, d) {
        nodeEls.style('opacity', '1');
        nodeEls.select<SVGTextElement>('text').attr('fill', n =>
          n.nodeType === 'project' ? '#7c3aed' : '#4a4a4a'
        );
        linkEls
          .attr('stroke', l => {
            const crossProject = asNode(l.source).nodeType === 'project' || asNode(l.target).nodeType === 'project';
            if (crossProject) return 'rgba(168,85,247,0.35)';
            return l.explicit ? 'rgba(255,255,255,0.28)' : 'rgba(255,255,255,0.05)';
          });
        select(this).select<SVGCircleElement>('circle')
          .attr('r', d.radius)
          .attr('stroke-width', 2);
        if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      });

    // ── Click → preview panel ─────────────────────────────────────────────
    const panel        = document.getElementById('preview-panel')!;
    const panelClose   = document.getElementById('preview-close')!;
    const thumbWrap    = document.getElementById('preview-thumb-wrap')!;
    const panelThumb   = document.getElementById('preview-thumb') as HTMLImageElement;
    const panelBadge   = document.getElementById('preview-type-badge')!;
    const panelTitle   = document.getElementById('preview-title')!;
    const panelTags    = document.getElementById('preview-tags')!;
    const panelDesc    = document.getElementById('preview-desc')!;
    const panelVisit   = document.getElementById('preview-visit') as HTMLAnchorElement;

    function showPanel(d: NodeDatum) {
      panelTitle.textContent = d.title;
      panelDesc.textContent  = d.description;
      panelVisit.href        = d.href;
      panelTags.innerHTML    = d.tags.map(t => `<span class="preview-tag">${t}</span>`).join('');

      if (d.nodeType === 'project') {
        panelBadge.textContent = 'Project';
        panelVisit.textContent = 'Open Project →';
        panelVisit.classList.add('project-link');
      } else {
        panelBadge.textContent = '';
        panelVisit.textContent = 'Open →';
        panelVisit.classList.remove('project-link');
      }

      if (d.thumbnail) {
        panelThumb.src = d.thumbnail;
        panelThumb.alt = d.title;
        thumbWrap.classList.remove('hidden');
      } else {
        thumbWrap.classList.add('hidden');
      }
      panel.classList.add('visible');
      panel.setAttribute('aria-hidden', 'false');
    }

    function hidePanel() {
      panel.classList.remove('visible');
      panel.setAttribute('aria-hidden', 'true');
    }

    panelClose.addEventListener('click', e => { e.stopPropagation(); hidePanel(); });

    nodeEls.on('click', (event, d) => {
      event.stopPropagation();
      showPanel(d);
    });

    // ── Drag ──────────────────────────────────────────────────────────────
    const dragBehavior = drag<SVGGElement, NodeDatum>()
      .clickDistance(4)
      .on('start', (event, d) => {
        if (!event.active) sim.alphaTarget(0.3).restart();
        d.fx = d.x;
        d.fy = d.y;
      })
      .on('drag', (event, d) => {
        d.fx = event.x;
        d.fy = event.y;
      })
      .on('end', (event, d) => {
        if (!event.active) sim.alphaTarget(0.06);
        d.fx = null;
        d.fy = null;
      });

    nodeEls.call(dragBehavior);

    // ── Simulation tick ───────────────────────────────────────────────────
    sim.on('tick', () => {
      linkEls
        .attr('x1', d => asNode(d.source).x ?? 0)
        .attr('y1', d => asNode(d.source).y ?? 0)
        .attr('x2', d => asNode(d.target).x ?? 0)
        .attr('y2', d => asNode(d.target).y ?? 0);

      nodeEls.attr('transform', d => `translate(${d.x ?? 0},${d.y ?? 0})`);
    });

    // ── Resize ────────────────────────────────────────────────────────────
    window.addEventListener('resize', () => {
      W = container.clientWidth;
      H = container.clientHeight;
      sim.force('center', forceCenter<NodeDatum>(W / 2, H / 2).strength(0.05));
      sim.alpha(0.3).restart();
    });
  }
</script>
