---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ImageGallery from '../../components/ImageGallery.astro';

export async function getStaticPaths() {
  const sketchbookItems = await getCollection('sketchbook');
  return sketchbookItems.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const hasVideos = item.data.videos && item.data.videos.length > 0;
const hasImages = item.data.images && item.data.images.length > 0;
---

<BaseLayout title={`${item.data.title} | Sketchbook`} description={item.data.description}>
  <article class="max-w-4xl mx-auto px-4 py-16">
    
    <header class="mb-8">
      <a href="/sketchbook" class="text-neutral-400 hover:text-white transition-colors mb-4 inline-block">
        ← Back to Sketchbook
      </a>
      
      <h1 class="text-4xl font-bold mb-4">{item.data.title}</h1>
      <p class="text-xl text-neutral-400 mb-4">{item.data.description}</p>
      
      <div class="flex gap-2 mb-6">
        {item.data.tags.map(tag => (
          <span class="text-sm bg-neutral-800 px-2 py-1 rounded">{tag}</span>
        ))}
      </div>
      
      <time class="text-sm text-neutral-500">
        {new Date(item.data.date).toLocaleDateString('en-US', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        })}
      </time>
    </header>

    {/* Thumbnail if available */}
    {item.data.thumbnail && (
      <div class="mb-8">
        <img 
          src={item.data.thumbnail} 
          alt={item.data.title}
          class="w-full rounded-lg"
        />
      </div>
    )}

    {/* Audio player if available */}
    {item.data.audioPreview && (
      <div class="mb-8">
        <audio controls class="w-full">
          <source src={item.data.audioPreview} type="audio/mpeg" />
          Your browser does not support the audio element.
        </audio>
      </div>
    )}

    {/* Video player if available */}
    {item.data.videoPreview && (
      <div class="mb-8">
        <video controls class="w-full rounded-lg">
          <source src={item.data.videoPreview} type="video/mp4" />
          Your browser does not support the video element.
        </video>
      </div>
    )}

    {/* Markdown content */}
    <div class="prose prose-invert max-w-none mb-12">
      <Content />
    </div>

    {/* Videos + Image Gallery */}
    {(hasVideos || hasImages) && (
      <div class="mb-8 flex flex-col">

        {hasVideos && (
          <div class="w-full mb-4">
            <h2 class="text-2xl font-semibold mb-6">
              {item.data.videos!.length === 1 ? 'Video' : 'Videos'}
            </h2>
            {item.data.videos!.map((video, i) => (
              <div class="mb-4">
                {video.title && (
                  <p class="text-neutral-400 text-sm mb-2">{video.title}</p>
                )}
                <VideoEmbed video={video} index={i} />
              </div>
            ))}
          </div>
        )}

        {hasImages && (
          <div class="w-full">
            <h2 class="text-2xl font-semibold mb-6">Documentation</h2>
            <ImageGallery images={item.data.images!} title={item.data.title} />
          </div>
        )}

      </div>
    )}
    
  </article>
</BaseLayout>